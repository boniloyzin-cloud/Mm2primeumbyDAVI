-- Helper: Identify Roles
local function getRole(player)
    if not player or not player.Character then return "Innocent" end
    if player.Backpack:FindFirstChild("Knife") or player.Character:FindFirstChild("Knife") then
        return "Murderer"
    elseif player.Backpack:FindFirstChild("Gun") or player.Character:FindFirstChild("Gun") then
        return "Sheriff"
    end
    return "Innocent"
end

local function getMurderer()
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and getRole(p) == "Murderer" then return p end
    end
    return nil
end

local function getSheriff()
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and getRole(p) == "Sheriff" then return p end
    end
    return nil
end

local function getNearestPlayer()
    local char = LocalPlayer.Character
    local myRoot = char and char:FindFirstChild("HumanoidRootPart")
    if not myRoot then return nil end

    local closestPlayer = nil
    local shortestDist = math.huge

    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
            local dist = (myRoot.Position - p.Character.HumanoidRootPart.Position).Magnitude
            if dist < shortestDist then
                shortestDist = dist
                closestPlayer = p
            end
        end
    end
    return closestPlayer
end

-- Helper: Locate Dropped Gun
local function findDroppedGun()
    return Workspace:FindFirstChild("GunDrop") 
        or Workspace:FindFirstChild("Gun")
        or (Workspace:FindFirstChild("Normal") and Workspace.Normal:FindFirstChild("GunDrop"))
end

-- Teleport & Grab Dropped Gun (1 Time)
local function grabGun()
    local gunDropPart = findDroppedGun()
    local char = LocalPlayer.Character
    if gunDropPart and char and char:FindFirstChild("HumanoidRootPart") then
        local oldCFrame = char.HumanoidRootPart.CFrame
        char.HumanoidRootPart.CFrame = gunDropPart.CFrame * CFrame.new(0, 1, 0)
        
        for _, prompt in pairs(gunDropPart:GetDescendants()) do
            if prompt:IsA("ProximityPrompt") then fireproximityprompt(prompt) end
        end
        firetouchinterest(char.HumanoidRootPart, gunDropPart, 0)
        firetouchinterest(char.HumanoidRootPart, gunDropPart, 1)

        task.wait(0.2)
        if char and char:FindFirstChild("HumanoidRootPart") then
            char.HumanoidRootPart.CFrame = oldCFrame
        end
    end
end

-- Fling Logic (Out of World)
local function executeFling(targetPlayer)
    if not targetPlayer or not targetPlayer.Character then return end
    local char = LocalPlayer.Character
    local targetChar = targetPlayer.Character
    
    local myRoot = char and char:FindFirstChild("HumanoidRootPart")
    local targetRoot = targetChar and targetChar:FindFirstChild("HumanoidRootPart")
    
    if not myRoot or not targetRoot then return end
    
    local oldPos = myRoot.CFrame
    local bav = Instance.new("BodyAngularVelocity")
    bav.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
    bav.AngularVelocity = Vector3.new(999999, 999999, 999999)
    bav.Parent = myRoot

    local timer = tick()
    while tick() - timer < 2.5 do
        RunService.Heartbeat:Wait()
        if targetRoot and targetRoot.Parent and myRoot and myRoot.Parent then
            myRoot.CFrame = targetRoot.CFrame
            myRoot.AssemblyLinearVelocity = Vector3.new(999999, 999999, 999999)
        else
            break
        end
    end
    
    bav:Destroy()
    myRoot.AssemblyLinearVelocity = Vector3.zero
    myRoot.CFrame = oldPos
end

-- Auto Shoot Core
local function shootMurderer()
    local murderer = getMurderer()
    local char = LocalPlayer.Character
    if not murderer or not murderer.Character or not murderer.Character:FindFirstChild("Head") then return end
    
    local gun = char and (char:FindFirstChild("Gun") or LocalPlayer.Backpack:FindFirstChild("Gun"))
    if gun then
        if gun.Parent == LocalPlayer.Backpack then gun.Parent = char end
        local shootEvent = gun:FindFirstChild("ShootEvent") or gun:FindFirstChild("Shoot")
        if shootEvent then
            local headPos = murderer.Character.Head.Position
            shootEvent:FireServer(CFrame.new(char.HumanoidRootPart.Position, headPos), CFrame.new(headPos))
        end
    end
end

-- Auto Throw Core (Target Specific)
local function throwKnifeAt(target)
    local char = LocalPlayer.Character
    local knife = char and (char:FindFirstChild("Knife") or LocalPlayer.Backpack:FindFirstChild("Knife"))
    if not knife or not target or not target.Character or not target.Character:FindFirstChild("HumanoidRootPart") then return end
    
    if knife.Parent == LocalPlayer.Backpack then knife.Parent = char end

    local throwEv = knife:FindFirstChild("Throw") or (knife:FindFirstChild("Events") and knife.Events:FindFirstChild("Throw"))
    if throwEv then
        throwEv:FireServer(
            target.Character.HumanoidRootPart.Position, 
            CFrame.new(char.HumanoidRootPart.Position, target.Character.HumanoidRootPart.Position)
        )
    end
end

-- TP & Shoot Murderer Core
local function tpAndShootMurderer()
    local murd = getMurderer()
    local char = LocalPlayer.Character
    if murd and murd.Character and char and char:FindFirstChild("HumanoidRootPart") then
        char.HumanoidRootPart.CFrame = murd.Character.HumanoidRootPart.CFrame * CFrame.new(0, 0, 4)
        task.wait(0.1)
        shootMurderer()
    end
end

