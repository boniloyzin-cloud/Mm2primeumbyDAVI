RunService.RenderStepped:Connect(function()
    ScreenUI.Enabled = OnScreenUI_Visible

    if ESP_Players_Enabled then
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character then
                local hl = p.Character:FindFirstChild("DAVI_ESP") or Instance.new("Highlight")
                hl.Name = "DAVI_ESP"
                hl.Adornee = p.Character
                hl.Parent = p.Character
                
                local role = getRole(p)
                if role == "Murderer" then hl.FillColor = Color3.fromRGB(255, 0, 0)
                elseif role == "Sheriff" then hl.FillColor = Color3.fromRGB(0, 100, 255)
                else hl.FillColor = Color3.fromRGB(0, 255, 100) end
            end
        end
    end

    local droppedGun = findDroppedGun()
    if ESP_Gun_Enabled and droppedGun then
        local ghl = droppedGun:FindFirstChild("DAVI_GunESP") or Instance.new("Highlight")
        ghl.Name = "DAVI_GunESP"
        ghl.Adornee = droppedGun
        ghl.FillColor = Color3.fromRGB(255, 255, 0)
        ghl.Parent = droppedGun
    end

    FOVCircle.Position = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    FOVCircle.Visible = FOV_Visible

    if Aimbot_Enabled then
        local murd = getMurderer()
        if murd and murd.Character and murd.Character:FindFirstChild("Head") then
            local headPos, onScreen = Camera:WorldToViewportPoint(murd.Character.Head.Position)
            local mousePos = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
            local dist = (Vector2.new(headPos.X, headPos.Y) - mousePos).Magnitude
            if onScreen and dist <= FOV_Radius then
                Camera.CFrame = CFrame.new(Camera.CFrame.Position, murd.Character.Head.Position)
            end
        end
    end
end)

